func parse_binding(src: int[], bg: Bags, cx: Cx): int {
    if cx.failed != 0 { return -1 }
    bump(cx)
    if kind_of(bg, cx) != 1 {
        fail(cx)
        return -1
    }
    let ns = bg.ts[cx.pos]
    let nl = bg.tn[cx.pos]
    bump(cx)
    if at_tok(bg, cx, 23) {
        bump(cx)
        parse_type(src, bg, cx)
    }
    var init = -1
    if at_tok(bg, cx, 27) {
        bump(cx)
        init = parse_expr(src, bg, cx, 1)
    }
    accept_tok(bg, cx, 24)
    return node(bg, 21, ns, nl, init, -1)
}

func parse_return(src: int[], bg: Bags, cx: Cx): int {
    if cx.failed != 0 { return -1 }
    let ret_line = bg.tl[cx.pos]
    bump(cx)
    var expr = -1
    if at_tok(bg, cx, 20) {
        expr = -1
    } else {
        if at_tok(bg, cx, 24) {
            expr = -1
        } else {
            if kind_of(bg, cx) == 0 {
                expr = -1
            } else {
                if cx.pos < bg.tl.len() && bg.tl[cx.pos] == ret_line {
                    expr = parse_expr(src, bg, cx, 1)
                }
            }
        }
    }
    accept_tok(bg, cx, 24)
    return node(bg, 23, 0, expr, -1, -1)
}

func parse_body(src: int[], bg: Bags, cx: Cx): int {
    if at_tok(bg, cx, 19) {
        return parse_block(src, bg, cx)
    }
    return parse_stmt(src, bg, cx)
}

func parse_if(src: int[], bg: Bags, cx: Cx): int {
    if cx.failed != 0 { return -1 }
    bump(cx)
    let saved = cx.no_struct
    cx.no_struct = 1
    let cond = parse_expr(src, bg, cx, 1)
    cx.no_struct = saved
    let th = parse_body(src, bg, cx)
    var el = -1
    if at_tok(bg, cx, 15) {
        bump(cx)
        el = parse_body(src, bg, cx)
    }
    return node(bg, 24, 0, cond, th, el)
}

func parse_while(src: int[], bg: Bags, cx: Cx): int {
    if cx.failed != 0 { return -1 }
    bump(cx)
    let saved = cx.no_struct
    cx.no_struct = 1
    let cond = parse_expr(src, bg, cx, 1)
    cx.no_struct = saved
    let body = parse_body(src, bg, cx)
    return node(bg, 25, 0, cond, body, -1)
}

func parse_block(src: int[], bg: Bags, cx: Cx): int {
    if cx.failed != 0 { return -1 }
    expect_tok(bg, cx, 19)
    var head = -1
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if at_tok(bg, cx, 20) {
                go = 0
            } else {
                if kind_of(bg, cx) == 0 {
                    fail(cx)
                    go = 0
                } else {
                    let st = parse_stmt(src, bg, cx)
                    head = node(bg, 13, 0, st, head, -1)
                }
            }
        }
    }
    expect_tok(bg, cx, 20)
    return node(bg, 26, 0, -1, head, -1)
}

func parse_stmt(src: int[], bg: Bags, cx: Cx): int {
    if cx.failed != 0 { return -1 }
    let k = kind_of(bg, cx)
    if k == 11 || k == 12 { return parse_binding(src, bg, cx) }
    if k == 19 { return parse_block(src, bg, cx) }
    if k == 13 { return parse_return(src, bg, cx) }
    if k == 14 { return parse_if(src, bg, cx) }
    if k == 16 { return parse_while(src, bg, cx) }
    let scoped = parse_scope_stmt(src, bg, cx)
    if scoped != -2 { return scoped }
    let e = parse_expr(src, bg, cx, 1)
    accept_tok(bg, cx, 24)
    return node(bg, 20, 0, e, -1, -1)
}

func parse_dotted(src: int[], bg: Bags, cx: Cx): unit {
    expect_tok(bg, cx, 1)
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if at_tok(bg, cx, 26) {
                bump(cx)
                expect_tok(bg, cx, 1)
            } else {
                go = 0
            }
        }
    }
    accept_tok(bg, cx, 24)
}

func parse_struct(src: int[], bg: Bags, cx: Cx): unit {
    if cx.failed != 0 { return }
    bump(cx)
    if kind_of(bg, cx) != 1 {
        fail(cx)
        return
    }
    let ns = bg.ts[cx.pos]
    let nl = bg.tn[cx.pos]
    bump(cx)
    let st = bg.st_ns.len()
    bg.st_ns.push(ns)
    bg.st_nl.push(nl)
    bg.st_kind.push(0)
    expect_tok(bg, cx, 19)
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if at_tok(bg, cx, 20) {
                go = 0
            } else {
                if kind_of(bg, cx) == 0 {
                    fail(cx)
                    go = 0
                } else {
                    if at_tok(bg, cx, 10) {
                        bump(cx)
                    }
                    if at_tok(bg, cx, 11) || at_tok(bg, cx, 12) {
                        bump(cx)
                        if kind_of(bg, cx) != 1 {
                            fail(cx)
                            go = 0
                        } else {
                            let fs = bg.ts[cx.pos]
                            let fl = bg.tn[cx.pos]
                            bump(cx)
                            expect_tok(bg, cx, 23)
                            let ty = parse_type(src, bg, cx)
                            if at_tok(bg, cx, 27) {
                                fail(cx)
                                go = 0
                            } else {
                                if at_tok(bg, cx, 19) {
                                    fail(cx)
                                    go = 0
                                } else {
                                    accept_tok(bg, cx, 24)
                                    bg.fd_st.push(st)
                                    bg.fd_ns.push(fs)
                                    bg.fd_nl.push(fl)
                                    bg.fd_ty.push(ty)
                                    bg.fd_init.push(-1)
                                }
                            }
                        }
                    } else {
                        fail(cx)
                        go = 0
                    }
                }
            }
        }
    }
    expect_tok(bg, cx, 20)
}

func parse_params(src: int[], bg: Bags, cx: Cx, fi: int): int {
    var arity = 0
    if at_tok(bg, cx, 18) {
        return 0
    }
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if kind_of(bg, cx) != 1 {
                fail(cx)
                go = 0
            } else {
                let ps = bg.ts[cx.pos]
                let pl = bg.tn[cx.pos]
                bump(cx)
                expect_tok(bg, cx, 23)
                let ty = parse_type(src, bg, cx)
                bg.par_fn.push(fi)
                bg.par_ns.push(ps)
                bg.par_nl.push(pl)
                bg.par_ty.push(ty)
                arity = arity + 1
                if at_tok(bg, cx, 25) {
                    bump(cx)
                    if at_tok(bg, cx, 18) {
                        go = 0
                    }
                } else {
                    go = 0
                }
            }
        }
    }
    return arity
}

func parse_func(src: int[], bg: Bags, cx: Cx): unit {
    if cx.failed != 0 { return }
    bump(cx)
    if kind_of(bg, cx) != 1 {
        fail(cx)
        return
    }
    let ns = bg.ts[cx.pos]
    let nl = bg.tn[cx.pos]
    bump(cx)
    let fi = bg.fn_ns.len()
    bg.fn_ns.push(ns)
    bg.fn_nl.push(nl)
    bg.fn_own.push(cx.decl_owner)
    bg.fn_async.push(cx.decl_async)
    bg.fn_pulsar.push(cx.decl_pulsar)
    if cx.decl_owner < 0 {
        if is_word(src, ns, nl, 4, 109, 97, 105, 110, 0, 0, 0, 0, 0, 0, 0, 0) {
            cx.main_idx = fi
        }
    }
    expect_tok(bg, cx, 17)
    let arity = parse_params(src, bg, cx, fi)
    expect_tok(bg, cx, 18)
    if at_tok(bg, cx, 23) {
        bump(cx)
        parse_type(src, bg, cx)
    }
    var body = -1
    if at_tok(bg, cx, 19) {
        body = parse_block(src, bg, cx)
    } else {
        if at_tok(bg, cx, 27) {
            bump(cx)
            let expr = parse_expr(src, bg, cx, 1)
            let ret = node(bg, 23, 0, expr, -1, -1)
            let head = node(bg, 13, 0, ret, -1, -1)
            body = node(bg, 26, 0, -1, head, -1)
            accept_tok(bg, cx, 24)
        } else {
            accept_tok(bg, cx, 24)
        }
    }
    if cx.decl_owner >= 0 {
        bg.fn_ar.push(arity + 1)
    } else {
        bg.fn_ar.push(arity)
    }
    bg.fn_body.push(body)
}

func parse_file(src: int[], bg: Bags, cx: Cx): unit {
    if at_tok(bg, cx, 6) {
        bump(cx)
        parse_dotted(src, bg, cx)
    }
    var go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if at_tok(bg, cx, 7) {
                bump(cx)
                parse_dotted(src, bg, cx)
            } else {
                go = 0
            }
        }
    }
    go = 1
    while go == 1 {
        if cx.failed != 0 {
            go = 0
        } else {
            if kind_of(bg, cx) == 0 {
                go = 0
            } else {
                scope_take_mods(src, bg, cx)
                if at_tok(bg, cx, 8) {
                    parse_struct(src, bg, cx)
                } else {
                    if at_tok(bg, cx, 9) || at_tok(bg, cx, 60) {
                        parse_func(src, bg, cx)
                    } else {
                        if parse_scope_decl(src, bg, cx) == 0 {
                            fail(cx)
                            go = 0
                        }
                    }
                }
            }
        }
    }
}

