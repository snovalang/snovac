func emit_call(src: int[], bg: Bags, cx: Cx, code: int[], fat: int[], fb: int[], callee: int, args: int): unit {
    if callee < 0 {
        fail(cx)
        return
    }
    let ck = bg.nk[callee]
    var ns = 0
    var nl = 0
    if ck == 4 {
        ns = bg.na[callee]
        nl = bg.nb[callee]
    }
    if ck == 10 {
        ns = bg.nc[callee]
        nl = bg.nd[callee]
    }
    if ck == 4 || ck == 10 {
        let which = name_print(src, ns, nl)
        if which != 0 {
            emit_print(src, bg, cx, code, fat, fb, args, which)
            return
        }
    }
    if ck == 4 && is_word(src, ns, nl, 10, 114, 101, 97, 100, 95, 98, 121, 116, 101, 115, 0, 0) && cons_count(bg, args) == 1 {
        emit_expr(src, bg, cx, code, fat, fb, cons_first(bg, args))
        code.push(47)
        cx.expr_ty = 0
        return
    }
    if ck == 4 && is_word(src, ns, nl, 11, 119, 114, 105, 116, 101, 95, 98, 121, 116, 101, 115, 0) && cons_count(bg, args) == 2 {
        emit_forward(src, bg, cx, code, fat, fb, args, 0)
        code.push(48)
        cx.expr_ty = 0
        return
    }
    if ck == 10 {
        let argc = cons_count(bg, args)
        let recv = bg.nb[callee]
        if argc == 0 && (is_word(src, ns, nl, 3, 108, 101, 110, 0, 0, 0, 0, 0, 0, 0, 0, 0) || is_word(src, ns, nl, 6, 108, 101, 110, 103, 116, 104, 0, 0, 0, 0, 0, 0)) {
            emit_expr(src, bg, cx, code, fat, fb, recv)
            code.push(49)
            cx.expr_ty = -1
            return
        }
        if argc == 1 && is_word(src, ns, nl, 4, 112, 117, 115, 104, 0, 0, 0, 0, 0, 0, 0, 0) {
            emit_expr(src, bg, cx, code, fat, fb, recv)
            emit_expr(src, bg, cx, code, fat, fb, cons_first(bg, args))
            code.push(50)
            cx.expr_ty = -1
            return
        }
        if argc == 1 && is_word(src, ns, nl, 3, 103, 101, 116, 0, 0, 0, 0, 0, 0, 0, 0, 0) {
            emit_expr(src, bg, cx, code, fat, fb, recv)
            emit_expr(src, bg, cx, code, fat, fb, cons_first(bg, args))
            code.push(40)
            cx.expr_ty = 0
            return
        }
    }
    var fn = -1
    if ck == 4 {
        fn = find_func(src, bg, ns, nl)
    }
    emit_forward(src, bg, cx, code, fat, fb, args, 0)
    if fn >= 0 {
        code.push(33)
        push_u32(code, fn)
        push_u32(code, cons_count(bg, args))
        cx.expr_ty = 0
    } else {
        fail(cx)
    }
}

func emit_struct(src: int[], bg: Bags, cx: Cx, code: int[], fat: int[], fb: int[], nd: int): unit {
    let ns = bg.na[nd]
    let nl = bg.nb[nd]
    let st = find_struct(src, bg, ns, nl)
    if st < 0 {
        fail(cx)
        return
    }
    var known = 0
    if struct_fields_known(src, bg, st, bg.nc[nd]) {
        known = 1
    }
    if known == 0 {
        fail(cx)
        return
    }
    var nfields = 0
    var i = 0
    while i < bg.fd_st.len() {
        if bg.fd_st[i] == st {
            let val = field_value(src, bg, bg.nc[nd], bg.fd_ns[i], bg.fd_nl[i])
            if val >= 0 {
                emit_expr(src, bg, cx, code, fat, fb, val)
            } else {
                emit_default(bg, code, bg.fd_ty[i])
            }
            nfields = nfields + 1
        }
        i = i + 1
    }
    let si = intern_span(src, ns, nl, bg)
    code.push(36)
    push_u32(code, si)
    push_u32(code, nfields)
    cx.expr_ty = st + 1
}

func emit_assign(src: int[], bg: Bags, cx: Cx, code: int[], fat: int[], fb: int[], lhs: int, rhs: int): unit {
    emit_expr(src, bg, cx, code, fat, fb, rhs)
    let rhs_ty = cx.expr_ty
    if lhs < 0 {
        fail(cx)
        return
    }
    if bg.nk[lhs] == 4 {
        let slot = find_local(src, bg, cx, bg.na[lhs], bg.nb[lhs])
        if slot < 0 {
            fail(cx)
            return
        }
        code.push(9)
        push_u32(code, slot)
        set_local_ty(bg, cx, slot, rhs_ty)
        cx.expr_ty = rhs_ty
        return
    }
    if bg.nk[lhs] == 10 {
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[lhs])
        let ty = cx.expr_ty
        var st = -1
        if ty > 0 {
            st = ty - 1
        }
        let fi = field_index(src, bg, st, bg.nc[lhs], bg.nd[lhs])
        if fi < 0 {
            fail(cx)
            return
        }
        code.push(38)
        push_u32(code, fi)
        cx.expr_ty = field_type_at(src, bg, st, bg.nc[lhs], bg.nd[lhs])
        return
    }
    fail(cx)
}

func emit_member(src: int[], bg: Bags, cx: Cx, code: int[], fat: int[], fb: int[], nd: int): unit {
    emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
    let ty = cx.expr_ty
    var st = -1
    if ty > 0 {
        st = ty - 1
    }
    let fi = field_index(src, bg, st, bg.nc[nd], bg.nd[nd])
    if fi < 0 {
        fail(cx)
        return
    }
    code.push(37)
    push_u32(code, fi)
    cx.expr_ty = field_type_at(src, bg, st, bg.nc[nd], bg.nd[nd])
}

func emit_expr(src: int[], bg: Bags, cx: Cx, code: int[], fat: int[], fb: int[], nd: int): unit {
    if cx.failed != 0 { return }
    if nd < 0 {
        fail(cx)
        return
    }
    let k = bg.nk[nd]
    cx.expr_ty = 0
    if scope_emit_expr(src, bg, cx, code, fat, fb, nd) != 0 { return }
    if k == 1 {
        code.push(1)
        push_i64(code, bg.na[nd])
        cx.expr_ty = 0
        return
    }
    if k == 2 {
        code.push(4)
        code.push(bg.na[nd])
        cx.expr_ty = 0
        return
    }
    if k == 3 {
        var tmp: int[] = []
        decode_string(src, bg.na[nd], bg.nb[nd], tmp)
        let si = intern_bytes(tmp, bg)
        code.push(3)
        push_u32(code, si)
        cx.expr_ty = 0
        return
    }
    if k == 4 {
        let slot = find_local(src, bg, cx, bg.na[nd], bg.nb[nd])
        if slot >= 0 {
            code.push(8)
            push_u32(code, slot)
            cx.expr_ty = local_type_of(bg, cx, slot)
            return
        }
        let fn = find_func(src, bg, bg.na[nd], bg.nb[nd])
        if fn >= 0 {
            code.push(1)
            push_i64(code, fn)
            cx.expr_ty = 0
            return
        }
        fail(cx)
        return
    }
    if k == 5 {
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        if bg.na[nd] == 35 {
            code.push(17)
        } else {
            if bg.na[nd] == 42 {
                code.push(18)
            } else {
                fail(cx)
            }
        }
        cx.expr_ty = 0
        return
    }
    if k == 6 {
        if bg.na[nd] == 43 {
            emit_and(src, bg, cx, code, fat, fb, bg.nb[nd], bg.nc[nd])
            return
        }
        if bg.na[nd] == 44 {
            emit_or(src, bg, cx, code, fat, fb, bg.nb[nd], bg.nc[nd])
            return
        }
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        emit_expr(src, bg, cx, code, fat, fb, bg.nc[nd])
        let op = bin_op(bg.na[nd])
        if op < 0 {
            fail(cx)
            return
        }
        code.push(op)
        cx.expr_ty = 0
        return
    }
    if k == 7 {
        emit_call(src, bg, cx, code, fat, fb, bg.nb[nd], bg.nc[nd])
        return
    }
    if k == 8 {
        emit_forward(src, bg, cx, code, fat, fb, bg.nc[nd], 0)
        code.push(39)
        push_u32(code, cons_count(bg, bg.nc[nd]))
        cx.expr_ty = 0
        return
    }
    if k == 9 {
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        emit_expr(src, bg, cx, code, fat, fb, bg.nc[nd])
        code.push(40)
        cx.expr_ty = 0
        return
    }
    if k == 10 {
        emit_member(src, bg, cx, code, fat, fb, nd)
        return
    }
    if k == 11 {
        emit_struct(src, bg, cx, code, fat, fb, nd)
        return
    }
    if k == 12 {
        emit_assign(src, bg, cx, code, fat, fb, bg.nb[nd], bg.nc[nd])
        return
    }
    fail(cx)
}

func emit_stmt(src: int[], bg: Bags, cx: Cx, code: int[], fat: int[], fb: int[], nd: int): unit {
    if cx.failed != 0 { return }
    if nd < 0 {
        fail(cx)
        return
    }
    let k = bg.nk[nd]
    if scope_emit_stmt(src, bg, cx, code, fat, fb, nd) != 0 { return }
    if k == 20 {
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        code.push(6)
        return
    }
    if k == 21 {
        if bg.nc[nd] >= 0 {
            emit_expr(src, bg, cx, code, fat, fb, bg.nc[nd])
        } else {
            code.push(5)
            cx.expr_ty = 0
        }
        let ty = cx.expr_ty
        let slot = add_local(bg, cx, bg.na[nd], bg.nb[nd], ty)
        code.push(9)
        push_u32(code, slot)
        code.push(6)
        return
    }
    if k == 23 {
        if bg.nb[nd] >= 0 {
            emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        } else {
            code.push(5)
        }
        code.push(35)
        return
    }
    if k == 24 {
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        let jelse = emit_jump(code, 31)
        emit_stmt(src, bg, cx, code, fat, fb, bg.nc[nd])
        if bg.nd[nd] >= 0 {
            let jend = emit_jump(code, 30)
            patch_at(code, fat, fb, jelse)
            emit_stmt(src, bg, cx, code, fat, fb, bg.nd[nd])
            patch_at(code, fat, fb, jend)
        } else {
            patch_at(code, fat, fb, jelse)
        }
        return
    }
    if k == 25 {
        let start = code.len()
        scope_loop_enter(bg, cx, start, 1)
        emit_expr(src, bg, cx, code, fat, fb, bg.nb[nd])
        let jexit = emit_jump(code, 31)
        emit_stmt(src, bg, cx, code, fat, fb, bg.nc[nd])
        code.push(30)
        let at = code.len()
        let off = start - (at + 4)
        push_u32(code, off)
        patch_at(code, fat, fb, jexit)
        scope_patch_brk(code, fat, fb, bg)
        scope_loop_leave(bg)
        return
    }
    if k == 26 {
        let saved = cx.locals
        emit_forward(src, bg, cx, code, fat, fb, bg.nc[nd], 1)
        cx.locals = saved
        return
    }
    fail(cx)
}

func emit_func(src: int[], bg: Bags, cx: Cx, fi: int): unit {
    cx.locals = 0
    cx.water = 0
    cx.loc_base = bg.loc_slot.len()
    cx.expr_ty = 0
    cx.owner = bg.fn_own[fi]
    if bg.fn_own[fi] >= 0 {
        add_local(bg, cx, 0, 0, bg.fn_own[fi] + 1)
    }
    var i = 0
    while i < bg.par_fn.len() {
        if bg.par_fn[i] == fi {
            add_local(bg, cx, bg.par_ns[i], bg.par_nl[i], bg.par_ty[i])
        }
        i = i + 1
    }
    var code: int[] = []
    var fat: int[] = []
    var fb: int[] = []
    if bg.fn_body[fi] < 0 {
        code.push(52)
    } else {
        emit_stmt(src, bg, cx, code, fat, fb, bg.fn_body[fi])
    }
    code.push(5)
    code.push(35)
    cx.owner = -1
    let off = bg.allc.len()
    var j = 0
    while j < code.len() {
        bg.allc.push(byte_at(code, fat, fb, j))
        j = j + 1
    }
    bg.fn_off.push(off)
    bg.fn_len.push(code.len())
    bg.fn_loc.push(cx.water)
}

func emit_unit(src: int[], bg: Bags, cx: Cx): unit {
    var fi = 0
    while fi < bg.fn_ns.len() {
        if cx.failed != 0 { return }
        emit_func(src, bg, cx, fi)
        fi = fi + 1
    }
}

