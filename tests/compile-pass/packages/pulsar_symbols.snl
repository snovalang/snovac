package tests.packages.pulsar_symbols


import builtin.concurrent.channels.queues
import builtin.pulsars.Pulsars
import builtin.io.console.output


pulsar func streamRange(max: int) ~> Channel<int> {
    var i = 0
    while i < max {
        return Channel.send(i)
        i = i + 1
    }
}

pulsar func oneShot(n: int): Channel<int> {
    return unit
}

pulsar func voidWorker(msg: string): unit {
    Console.printline(msg)
}

func main(): int {
    let ch = pulsar streamRange(3)
    let shot = pulsar oneShot(4)
    pulsar voidWorker("ok")
    Pulsars.yield()
    return 0
}
