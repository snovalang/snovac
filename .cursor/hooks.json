{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/guard-invariants.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/guard-invariants.py --stop",
        "timeout": 15,
        "loop_limit": 1
      }
    ]
  }
}
