package builtin.collections.collections

import builtin.types

struct MapEntry<K, V> {
    public let key: K
    public let value: V

    public static method new(key: K, value: V): MapEntry<K, V> {
        return MapEntry { key: key, value: value }
    }
}

// Equality-based map with insertion order and linear lookup.
class Map<K, V> {
    private var _keys: Array<K> = Array<K>.new()
    private var _values: Array<V> = Array<V>.new()

    public static method new(): Map<K, V> {
        return Map<K, V>()
    }

    public method length(): int = _keys.length()

    public method isEmpty(): bool = _keys.isEmpty()

    public method containsKey(key: K): bool {
        var i = 0
        while i < _keys.length() {
            if _keys.get(i) == key {
                return true
            }
            i += 1
        }
        return false
    }

    public method containsValue(value: V): bool {
        var i = 0
        while i < _values.length() {
            if _values.get(i) == value {
                return true
            }
            i += 1
        }
        return false
    }

    public method get(key: K): Option<V> {
        var i = 0
        while i < _keys.length() {
            if _keys.get(i) == key {
                return Some(_values.get(i))
            }
            i += 1
        }
        return None
    }

    // Returns true when the key was added, false when an entry was replaced.
    public method put(key: K, value: V): bool {
        var i = 0
        while i < _keys.length() {
            if _keys.get(i) == key {
                _values.set(i, value)
                return false
            }
            i += 1
        }
        _keys.push(key)
        _values.push(value)
        return true
    }

    // Replaces an existing value and returns the previous value, or None when
    // the key was absent. A stored Option<V> remains distinguishable because
    // the result wraps the entire value in another Option.
    public method replace(key: K, value: V): Option<V> {
        var i = 0
        while i < _keys.length() {
            if _keys.get(i) == key {
                var previous = _values.get(i)
                _values.set(i, value)
                return Some(previous)
            }
            i += 1
        }
        return None
    }

    public method getOrDefault(key: K, fallback: V): V {
        match this.get(key) {
            Some(value) -> return value
            None -> return fallback
        }
    }

    public method keys(): Array<K> {
        var result = Array<K>.new()
        var i = 0
        while i < _keys.length() {
            result.push(_keys.get(i))
            i += 1
        }
        return result
    }

    public method values(): Array<V> {
        var result = Array<V>.new()
        var i = 0
        while i < _values.length() {
            result.push(_values.get(i))
            i += 1
        }
        return result
    }

    public method entries(): Array<MapEntry<K, V>> {
        var result = Array<MapEntry<K, V>>.new()
        var i = 0
        while i < _keys.length() {
            result.push(MapEntry<K, V>.new(_keys.get(i), _values.get(i)))
            i += 1
        }
        return result
    }

    public method forEach(action: (K, V) -> unit): unit {
        var keys = Array<K>.new()
        var values = Array<V>.new()
        var i = 0
        while i < _keys.length() {
            keys.push(_keys.get(i))
            values.push(_values.get(i))
            i += 1
        }
        i = 0
        while i < keys.length() {
            action(keys.get(i), values.get(i))
            i += 1
        }
    }

    public method mapValues<U>(transform: (K, V) -> U): Map<K, U> {
        var result: Map<K, U> = Map<K, U>()
        var keys = Array<K>.new()
        var values = Array<V>.new()
        var i = 0
        while i < _keys.length() {
            keys.push(_keys.get(i))
            values.push(_values.get(i))
            i += 1
        }
        i = 0
        while i < keys.length() {
            result.put(keys.get(i), transform(keys.get(i), values.get(i)))
            i += 1
        }
        return result
    }

    public method mapKeys<U>(transform: (K) -> U): Map<U, V> {
        var result: Map<U, V> = Map<U, V>()
        var keys = Array<K>.new()
        var values = Array<V>.new()
        var i = 0
        while i < _keys.length() {
            keys.push(_keys.get(i))
            values.push(_values.get(i))
            i += 1
        }
        i = 0
        while i < keys.length() {
            result.put(transform(keys.get(i)), values.get(i))
            i += 1
        }
        return result
    }

    public method filter(predicate: (K, V) -> bool): Map<K, V> {
        var result = Map<K, V>.new()
        var keys = Array<K>.new()
        var values = Array<V>.new()
        var i = 0
        while i < _keys.length() {
            keys.push(_keys.get(i))
            values.push(_values.get(i))
            i += 1
        }
        i = 0
        while i < keys.length() {
            var key = keys.get(i)
            var value = values.get(i)
            if predicate(key, value) {
                result.put(key, value)
            }
            i += 1
        }
        return result
    }

    public method putAll(other: Map<K, V>): unit {
        var i = 0
        while i < other._keys.length() {
            this.put(other._keys.get(i), other._values.get(i))
            i += 1
        }
    }

    public method copy(): Map<K, V> {
        var result = Map<K, V>.new()
        result.putAll(this)
        return result
    }

    public method putIfAbsent(key: K, value: V): bool {
        if this.containsKey(key) {
            return false
        }
        _keys.push(key)
        _values.push(value)
        return true
    }

    public method getOrPut(key: K, create: () -> V): V {
        match this.get(key) {
            Some(value) -> return value
            None -> {
                var value = create()
                this.put(key, value)
                return value
            }
        }
    }

    public method remove(key: K): bool {
        var i = 0
        while i < _keys.length() {
            if _keys.get(i) == key {
                var j = i
                while j + 1 < _keys.length() {
                    _keys.set(j, _keys.get(j + 1))
                    _values.set(j, _values.get(j + 1))
                    j += 1
                }
                _keys.pop()
                _values.pop()
                return true
            }
            i += 1
        }
        return false
    }

    public method removeAndGet(key: K): Option<V> {
        var i = 0
        while i < _keys.length() {
            if _keys.get(i) == key {
                var previous = _values.get(i)
                var j = i
                while j + 1 < _keys.length() {
                    _keys.set(j, _keys.get(j + 1))
                    _values.set(j, _values.get(j + 1))
                    j += 1
                }
                _keys.pop()
                _values.pop()
                return Some(previous)
            }
            i += 1
        }
        return None
    }

    public method clear(): unit {
        _keys.clear()
        _values.clear()
    }
}
