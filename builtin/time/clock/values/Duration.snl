package builtin.time.clock.values

import builtin.errors.hierarchy.types

import builtin.core.types.values

struct Duration {
    private let nanoseconds: long

    public static method fromNanoseconds(value: long): Duration {
        return Duration { nanoseconds: value }
    }

    public static method seconds(value: long): Duration {
        match Duration.checkedSeconds(value) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.seconds reached an invalid state")
    }

    public static method checkedSeconds(value: long): Result<Duration, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if value > maximum / 1000000000L || value < minimum / 1000000000L {
            return Err("Duration seconds overflow nanosecond range")
        }
        return Ok(Duration { nanoseconds: value * 1000000000L })
    }

    public static method milliseconds(value: long): Duration {
        match Duration.checkedMilliseconds(value) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.milliseconds reached an invalid state")
    }

    public static method checkedMilliseconds(value: long): Result<Duration, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if value > maximum / 1000000L || value < minimum / 1000000L {
            return Err("Duration milliseconds overflow nanosecond range")
        }
        return Ok(Duration { nanoseconds: value * 1000000L })
    }

    public method toNanoseconds(): long {
        return nanoseconds
    }

    public method toSeconds(): long {
        return nanoseconds / 1000000000L
    }

    public method toMilliseconds(): long {
        return nanoseconds / 1000000L
    }

    public method toMicroseconds(): long {
        return nanoseconds / 1000L
    }

    public method isZero(): bool {
        return nanoseconds == 0L
    }

    public method isNegative(): bool {
        return nanoseconds < 0L
    }

    public method isPositive(): bool {
        return nanoseconds > 0L
    }

    public method plus(other: Duration): Duration {
        match this.checkedPlus(other) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.plus reached an invalid state")
    }

    public method checkedPlus(other: Duration): Result<Duration, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if (other.nanoseconds > 0L && nanoseconds > maximum - other.nanoseconds) ||
            (other.nanoseconds < 0L && nanoseconds < minimum - other.nanoseconds) {
            return Err("Duration addition overflow")
        }
        return Ok(Duration { nanoseconds: nanoseconds + other.nanoseconds })
    }

    public method minus(other: Duration): Duration {
        match this.checkedMinus(other) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.minus reached an invalid state")
    }

    public method checkedMinus(other: Duration): Result<Duration, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if (other.nanoseconds < 0L && nanoseconds > maximum + other.nanoseconds) ||
            (other.nanoseconds > 0L && nanoseconds < minimum + other.nanoseconds) {
            return Err("Duration subtraction overflow")
        }
        return Ok(Duration { nanoseconds: nanoseconds - other.nanoseconds })
    }

    public method multipliedBy(factor: long): Duration {
        match this.checkedMultiply(factor) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.multipliedBy reached an invalid state")
    }

    public method checkedMultiply(factor: long): Result<Duration, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if factor == 0L || nanoseconds == 0L {
            return Ok(Duration { nanoseconds: 0L })
        }
        if (nanoseconds == minimum && factor == -1L) || (factor == minimum && nanoseconds == -1L) {
            return Err("Duration multiplication overflow")
        }
        if nanoseconds > 0L {
            if factor > 0L && nanoseconds > maximum / factor { return Err("Duration multiplication overflow") }
            if factor < 0L && factor < minimum / nanoseconds { return Err("Duration multiplication overflow") }
        } else {
            if factor > 0L && nanoseconds < minimum / factor { return Err("Duration multiplication overflow") }
            if factor < 0L && nanoseconds < maximum / factor { return Err("Duration multiplication overflow") }
        }
        return Ok(Duration { nanoseconds: nanoseconds * factor })
    }

    public method dividedBy(divisor: long): Duration {
        match this.checkedDivide(divisor) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.dividedBy reached an invalid state")
    }

    public method checkedDivide(divisor: long): Result<Duration, string> {
        if divisor == 0L {
            return Err("Duration.dividedBy divisor cannot be zero")
        }
        if nanoseconds == -9223372036854775807L - 1L && divisor == -1L {
            return Err("Duration division overflow")
        }
        return Ok(Duration { nanoseconds: nanoseconds / divisor })
    }

    public method compareTo(other: Duration): int {
        if nanoseconds < other.nanoseconds { return -1 }
        if nanoseconds > other.nanoseconds { return 1 }
        return 0
    }

    public method abs(): Duration {
        match this.checkedAbs() {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Duration.abs reached an invalid state")
    }

    public method checkedAbs(): Result<Duration, string> {
        if nanoseconds < 0L {
            if nanoseconds == -9223372036854775807L - 1L {
                return Err("Duration absolute value overflow")
            }
            return Ok(Duration { nanoseconds: -nanoseconds })
        }
        return Ok(this)
    }
}
