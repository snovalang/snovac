package builtin.time.time

import builtin.errors.errors

import builtin.types

struct Instant {
    private let monotonicNanoseconds: int64

    public static method fromMonotonicNanoseconds(value: int64): Instant {
        return Instant { monotonicNanoseconds: value }
    }

    public method toMonotonicNanoseconds(): int64 {
        return monotonicNanoseconds
    }

    public method compareTo(other: Instant): int {
        if monotonicNanoseconds < other.monotonicNanoseconds { return -1 }
        if monotonicNanoseconds > other.monotonicNanoseconds { return 1 }
        return 0
    }

    public method isBefore(other: Instant): bool {
        return monotonicNanoseconds < other.monotonicNanoseconds
    }

    public method isAfter(other: Instant): bool {
        return monotonicNanoseconds > other.monotonicNanoseconds
    }

    public method elapsedSince(earlier: Instant): Duration {
        match this.checkedElapsedSince(earlier) {
            Ok(duration) -> return duration
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Instant.elapsedSince reached an invalid state")
    }

    public method checkedElapsedSince(earlier: Instant): Result<Duration, string> {
        if earlier.monotonicNanoseconds > monotonicNanoseconds {
            return Err("Instant.elapsedSince requires an earlier instant")
        }
        var zero: int64 = 0L as int64
        var maximum: int64 = 9223372036854775807L as int64
        var minimum: int64 = (-9223372036854775807L - 1L) as int64
        if (earlier.monotonicNanoseconds < zero && monotonicNanoseconds > maximum + earlier.monotonicNanoseconds) ||
            (earlier.monotonicNanoseconds > zero && monotonicNanoseconds < minimum + earlier.monotonicNanoseconds) {
            return Err("Instant elapsed duration overflow")
        }
        return Ok(Duration.fromNanoseconds((monotonicNanoseconds - earlier.monotonicNanoseconds) as long))
    }

    public method plus(duration: Duration): Instant {
        match this.checkedPlus(duration) {
            Ok(instant) -> return instant
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Instant.plus reached an invalid state")
    }

    public method checkedPlus(duration: Duration): Result<Instant, string> {
        var delta = duration.toNanoseconds() as int64
        var zero: int64 = 0L as int64
        var maximum: int64 = 9223372036854775807L as int64
        var minimum: int64 = (-9223372036854775807L - 1L) as int64
        if (delta > zero && monotonicNanoseconds > maximum - delta) ||
            (delta < zero && monotonicNanoseconds < minimum - delta) {
            return Err("Instant addition overflow")
        }
        return Ok(Instant { monotonicNanoseconds: monotonicNanoseconds + delta })
    }

    public method minus(duration: Duration): Instant {
        match this.checkedMinus(duration) {
            Ok(instant) -> return instant
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Instant.minus reached an invalid state")
    }

    public method checkedMinus(duration: Duration): Result<Instant, string> {
        var delta = duration.toNanoseconds() as int64
        var zero: int64 = 0L as int64
        var maximum: int64 = 9223372036854775807L as int64
        var minimum: int64 = (-9223372036854775807L - 1L) as int64
        if (delta < zero && monotonicNanoseconds > maximum + delta) ||
            (delta > zero && monotonicNanoseconds < minimum + delta) {
            return Err("Instant subtraction overflow")
        }
        return Ok(Instant { monotonicNanoseconds: monotonicNanoseconds - delta })
    }
}
