package builtin.errors.errors

// Error is the checked-error root. Operations report these through Result<T, E>
// or an explicit function error contract; they are not silently converted to
// runtime exceptions.
class Error {
    public method message(): string {
        return "error"
    }

    public method code(): string {
        return "error"
    }

    public override method toString(): string {
        return this.code() + ": " + this.message()
    }
}

class ParseError extends Error {
    public let detail: string

    override method message(): string {
        return detail
    }

    override method code(): string {
        return "parse_error"
    }
}

class MathError extends Error {
    public let detail: string

    override method message(): string {
        return detail
    }

    override method code(): string {
        return "math_error"
    }
}

class IoError extends Error {
    public let detail: string

    override method message(): string {
        return detail
    }

    override method code(): string {
        return "io_error"
    }
}

class ValidationError extends Error {
    public let detail: string

    override method message(): string {
        return detail
    }

    override method code(): string {
        return "validation_error"
    }
}

class TimeoutError extends Error {
    public let detail: string

    override method message(): string {
        return detail
    }

    override method code(): string {
        return "timeout_error"
    }
}

class CancelledError extends Error {
    public let detail: string

    override method message(): string {
        return detail
    }

    override method code(): string {
        return "cancelled_error"
    }
}

// Exception is the unchecked, runtime-only failure root. It is deliberately
// separate from Error so catching an exception never satisfies a checked
// Error obligation.
class Exception {
    public method message(): string {
        return "exception"
    }

    public override method toString(): string {
        return this.message()
    }
}

class RuntimeException extends Exception {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class IllegalArgumentException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class IllegalStateException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class IndexOutOfBoundsException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class ArithmeticException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class MissingValueException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class CancellationException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class IoException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class NullPointerException extends RuntimeException {
    public let detail: string

    override method message(): string {
        return detail
    }
}

class WrappedException extends RuntimeException {
    public let detail: string
    public let cause: Exception

    override method message(): string {
        return detail
    }
}

class Errors {
    public static method new(message: string): RuntimeException {
        return RuntimeException(message)
    }

    public static method wrap(cause: Exception, message: string): WrappedException {
        return WrappedException { detail: message, cause: cause }
    }
}
