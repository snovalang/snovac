package builtin.types

// Primitive method signatures are part of the language library. Their bodies
// are provided by the runtime's primitive value implementation.
extension string {
    @Native public method toString(): string
    @Native public method equals(other: string): bool
    @Native public method hashCode(): int
    @Native public method length(): int
    @Native public method len(): int
    @Native public method toUpper(): string
    @Native public method toLower(): string
    @Native public method charAt(index: int): char
    @Native public method substring(start: int, end: int): string
    @Native public method trim(): string
    @Native public method trimStart(): string
    @Native public method trimEnd(): string
    @Native public method startsWith(prefix: string): bool
    @Native public method endsWith(suffix: string): bool
    @Native public method contains(value: string): bool
    @Native public method indexOf(value: string): int
    @Native public method lastIndexOf(value: string): int
    @Native public method split(separator: string): Array<string>
    @Native public method replace(oldValue: string, newValue: string): string
    @Native public method isEmpty(): bool
}

extension int {
    @Native public method toString(): string
    @Native public method equals(other: int): bool
    @Native public method hashCode(): int
}

extension long {
    @Native public method toString(): string
    @Native public method equals(other: long): bool
    @Native public method hashCode(): int
}

