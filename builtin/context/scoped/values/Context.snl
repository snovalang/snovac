    private method childWithTypedValue<T>(key: string, value: T): Context {
        if key.isEmpty() { throw IllegalArgumentException("Context value key cannot be empty") }
        var child = Context.child(this, deadline)
        child.localKeys.push(key)
        child.localValues.push(ContextValue.AnyValue(value as any))
        return child
    }

    public method getValue(key: string): Option<string> {
        return Context.value(this, key)
    }

    public method getIntValue(key: string): Option<int> {
        var i = localKeys.length() - 1
        while i >= 0 {
            if localKeys.get(i) == key {
                match localValues.get(i) {
                    IntValue(value) -> return Some(value)
                    _ -> return None
                }
            }
            i -= 1
        }
        match parent {
            Some(value) -> return value.getIntValue(key)
            None -> return None
        }
        return None
    }

    public method getLongValue(key: string): Option<long> {
        var i = localKeys.length() - 1
        while i >= 0 {
