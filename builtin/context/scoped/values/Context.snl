        return None
    }

    public method isDone(): bool {
        return this.err().isSome()
    }

    public method err(): Option<ContextError> {
        if this.isDeadlineExceeded() {
            return Some(ContextError.DeadlineExceeded)
        }
        if cancellation.isCancelled() {
            return Some(ContextError.Cancelled)
        }
        match parent {
            Some(value) -> return value.err()
            None -> return None
        }
        return None
    }

    public method isDeadlineExceeded(): bool {
        match deadline {
            Some(value) -> return Time.now().compareTo(value) >= 0
            None -> return false
        }
        return false
    }

    public method cancel(): bool {
        return cancellation.cancel()
    }

    public method throwIfDone(): unit {
        match this.err() {
            Some(error) -> throw error
            None -> {}
        }
    }
}

extension Context {
    public method withCancel(): CancelHandle {
        return CancelHandle.new(Context.withCancel(this))
    }

    public method withTimeout(duration: Duration): Context {
        return this.childWithTimeout(duration)
    }

    public method withDeadline(next: Instant): Context {
        return this.childWithDeadline(next)
    }

    public method withValue(key: string, value: string): Context {
        return this.childWithValue(key, value)
    }

    public method withIntValue(key: string, value: int): Context {
        return this.childWithIntValue(key, value)
    }

    public method withLongValue(key: string, value: long): Context {
        return this.childWithLongValue(key, value)
    }

    public method withBoolValue(key: string, value: bool): Context {
        return this.childWithBoolValue(key, value)
    }

    public method withInt8Value(key: string, value: int8): Context {
        return this.childWithInt8Value(key, value)
    }

    public method withInt16Value(key: string, value: int16): Context {
        return this.childWithInt16Value(key, value)
    }

    public method withInt32Value(key: string, value: int32): Context {
        return this.childWithInt32Value(key, value)
    }

    public method withInt64Value(key: string, value: int64): Context {
        return this.childWithInt64Value(key, value)
    }

    public method withInt128Value(key: string, value: int128): Context {
        return this.childWithInt128Value(key, value)
    }

    public method withByteValue(key: string, value: byte): Context {
        return this.childWithByteValue(key, value)
    }

    public method withFloatValue(key: string, value: float): Context {
        return this.childWithFloatValue(key, value)
    }

    public method withDoubleValue(key: string, value: double): Context {
        return this.childWithDoubleValue(key, value)
    }

    public method withDecimalValue(key: string, value: decimal): Context {
        return this.childWithDecimalValue(key, value)
    }

    public method withCharValue(key: string, value: char): Context {
        return this.childWithCharValue(key, value)
    }

    public method withTypedValue<T>(key: string, value: T): Context {
        return this.childWithTypedValue(key, value)
    }

    // The witness supplies T for the same reason as Context.valueAs. A key
    // found in this context or its ancestors must contain a value of that type.
    public method valueAs<T>(key: string, typeWitness: T): T {
        return Context.valueAs(this, key, typeWitness)
    }
}

class CancelHandle {
    private let value: Context

    public static method new(context: Context): CancelHandle {
        return CancelHandle { value: context }
    }

    public method context(): Context {
        return value
    }

    public method cancel(): bool {
        return value.cancel()
    }
}
