package builtin.context.scoped.values

import builtin.errors.hierarchy.types

import builtin.collections.collections.types
import builtin.concurrent.async.tasks
import builtin.time.clock.values
import builtin.core.types.values

enum ContextError {
    Cancelled,
    DeadlineExceeded
}

private enum ContextValue {
    StringValue(value: string),
    IntValue(value: int),
    LongValue(value: long),
    Int8Value(value: int8),
    Int16Value(value: int16),
    Int32Value(value: int32),
    Int64Value(value: int64),
    Int128Value(value: int128),
    ByteValue(value: byte),
    FloatValue(value: float),
    DoubleValue(value: double),
    DecimalValue(value: decimal),
    CharValue(value: char),
    AnyValue(value: any),
    BoolValue(value: bool)
}

class Context {
    private let parent: Option<Context>
    private let cancellation: CancellationToken
    private let deadline: Option<Instant>
    private let localKeys: Array<string>
    private let localValues: Array<ContextValue>

    public static method background(): Context {
        return Context {
            parent: None,
            cancellation: CancellationToken.new(),
            deadline: None,
            localKeys: Array<string>.new(),
            localValues: Array<ContextValue>.new()
        }
    }

    public static method withCancel(parent: Context): Context {
        return Context.child(parent, parent.deadline)
    }

    public static method withCancelHandle(parent: Context): CancelHandle {
        return CancelHandle.new(Context.withCancel(parent))
    }

    public static method withTimeout(parent: Context, milliseconds: int): Context {
        if milliseconds < 0 {
            throw IllegalArgumentException("Context timeout cannot be negative")
        }
        var duration = Duration.milliseconds(milliseconds as long)
        return parent.childWithTimeout(duration)
    }

    public static method withDeadline(parent: Context, deadline: Instant): Context {
        return Context.child(parent, Context.minDeadline(parent.deadline, Some(deadline)))
    }

    public static method withValue(parent: Context, key: string, value: string): Context {
        return parent.childWithValue(key, value)
    }

    public static method withIntValue(parent: Context, key: string, value: int): Context {
        return parent.childWithIntValue(key, value)
    }

    public static method withLongValue(parent: Context, key: string, value: long): Context {
        return parent.childWithLongValue(key, value)
    }

    public static method withBoolValue(parent: Context, key: string, value: bool): Context {
        return parent.childWithBoolValue(key, value)
    }

    public static method withInt8Value(parent: Context, key: string, value: int8): Context {
        return parent.childWithInt8Value(key, value)
    }

    public static method withInt16Value(parent: Context, key: string, value: int16): Context {
        return parent.childWithInt16Value(key, value)
    }

    public static method withInt32Value(parent: Context, key: string, value: int32): Context {
        return parent.childWithInt32Value(key, value)
    }

    public static method withInt64Value(parent: Context, key: string, value: int64): Context {
        return parent.childWithInt64Value(key, value)
    }

    public static method withInt128Value(parent: Context, key: string, value: int128): Context {
        return parent.childWithInt128Value(key, value)
    }

    public static method withByteValue(parent: Context, key: string, value: byte): Context {
        return parent.childWithByteValue(key, value)
    }

    public static method withFloatValue(parent: Context, key: string, value: float): Context {
        return parent.childWithFloatValue(key, value)
    }

    public static method withDoubleValue(parent: Context, key: string, value: double): Context {
        return parent.childWithDoubleValue(key, value)
    }

    public static method withDecimalValue(parent: Context, key: string, value: decimal): Context {
        return parent.childWithDecimalValue(key, value)
    }

    public static method withCharValue(parent: Context, key: string, value: char): Context {
        return parent.childWithCharValue(key, value)
    }

    public static method withTypedValue<T>(parent: Context, key: string, value: T): Context {
        return parent.childWithTypedValue(key, value)
    }

    public static method value(context: Context, key: string): Option<string> {
        var i = context.localKeys.length() - 1
        while i >= 0 {
            if context.localKeys.get(i) == key {
                match context.localValues.get(i) {
                    StringValue(value) -> return Some(value)
                    _ -> return None
                }
            }
            i -= 1
        }
        match context.parent {
            Some(parent) -> return Context.value(parent, key)
            None -> return None
        }
        return None
    }

    // The witness supplies T because the checker does not infer a generic
    // result type from the key alone. Callers must use the same type they
    // stored; the current runtime has no general nominal type-test operation.
    public static method valueAs<T>(context: Context, key: string, typeWitness: T): T {
        var ignored = typeWitness
        var i = context.localKeys.length() - 1
        while i >= 0 {
            if context.localKeys.get(i) == key {
                match context.localValues.get(i) {
                    StringValue(value) -> return value as T
                    IntValue(value) -> return value as T
                    LongValue(value) -> return value as T
                    Int8Value(value) -> return value as T
                    Int16Value(value) -> return value as T
                    Int32Value(value) -> return value as T
                    Int64Value(value) -> return value as T
                    Int128Value(value) -> return value as T
                    ByteValue(value) -> return value as T
                    FloatValue(value) -> return value as T
                    DoubleValue(value) -> return value as T
                    DecimalValue(value) -> return value as T
                    CharValue(value) -> return value as T
                    BoolValue(value) -> return value as T
                    AnyValue(value) -> return value as T
                }
            }
            i -= 1
        }
        match context.parent {
            Some(parent) -> return Context.valueAs(parent, key, typeWitness)
            None -> throw MissingValueException("Context value was not found")
        }
        throw IllegalStateException("Context.valueAs reached an invalid state")
    }

    public static method intValue(context: Context, key: string): Option<int> {
        return context.getIntValue(key)
    }

    public static method longValue(context: Context, key: string): Option<long> {
        return context.getLongValue(key)
    }

    public static method boolValue(context: Context, key: string): Option<bool> {
        return context.getBoolValue(key)
    }

    public static method int8Value(context: Context, key: string): Option<int8> {
        return context.getInt8Value(key)
    }

    public static method int16Value(context: Context, key: string): Option<int16> {
        return context.getInt16Value(key)
    }

    public static method int32Value(context: Context, key: string): Option<int32> {
        return context.getInt32Value(key)
    }

    public static method int64Value(context: Context, key: string): Option<int64> {
        return context.getInt64Value(key)
    }

    public static method int128Value(context: Context, key: string): Option<int128> {
        return context.getInt128Value(key)
    }

    public static method byteValue(context: Context, key: string): Option<byte> {
        return context.getByteValue(key)
    }

    public static method floatValue(context: Context, key: string): Option<float> {
        return context.getFloatValue(key)
    }

    public static method doubleValue(context: Context, key: string): Option<double> {
        return context.getDoubleValue(key)
    }

    public static method decimalValue(context: Context, key: string): Option<decimal> {
        return context.getDecimalValue(key)
    }

    public static method charValue(context: Context, key: string): Option<char> {
        return context.getCharValue(key)
    }

    private static method child(parent: Context, deadline: Option<Instant>): Context {
        return Context {
            parent: Some(parent),
            cancellation: CancellationToken.new(),
            deadline: deadline,
            localKeys: Array<string>.new(),
            localValues: Array<ContextValue>.new()
        }
    }

    private static method minDeadline(
        inherited: Option<Instant>, requested: Option<Instant>
    ): Option<Instant> {
        match inherited {
            Some(existing) -> {
                match requested {
                    Some(next) -> {
                        if existing.isBefore(next) {
                            return Some(existing)
                        }
                        return Some(next)
                    }
                    None -> return Some(existing)
                }
            }
            None -> return requested
        }
        return None
    }

    private method childWithTimeout(duration: Duration): Context {
        if duration.isNegative() {
            throw IllegalArgumentException("Context timeout cannot be negative")
        }
        var candidate = Time.now().plus(duration)
        return Context.child(this, Context.minDeadline(deadline, Some(candidate)))
    }

    private method childWithDeadline(next: Instant): Context {
        return Context.child(this, Context.minDeadline(deadline, Some(next)))
    }

    private method childWithValue(key: string, value: string): Context {
        if key.isEmpty() {
            throw IllegalArgumentException("Context value key cannot be empty")
        }
        var child = Context.child(this, deadline)
        child.localKeys.push(key)
        child.localValues.push(ContextValue.StringValue(value))
        return child
    }

    private method childWithIntValue(key: string, value: int): Context {
        if key.isEmpty() { throw IllegalArgumentException("Context value key cannot be empty") }
        var child = Context.child(this, deadline)
        child.localKeys.push(key)
        child.localValues.push(ContextValue.IntValue(value))
        return child
    }

