package builtin.concurrent.channels.queues

import builtin.errors.hierarchy.types

import builtin.collections.collections.types
import builtin.concurrent.synchronization.primitives

enum ChannelSendStatus {
    Sent,
    Full,
    Closed
}

enum ChannelReceiveStatus<T> {
    Value(value: T),
    Empty,
    Closed
}

// A bounded FIFO with atomic non-blocking operations. Blocking send/receive
// and select require scheduler support and are intentionally not simulated.
class Channel<T> {
    private let capacityValue: int
    private let lockHandle: int = NativeMutex.mutexCreate()
    private var buffer: Array<T> = Array<T>.new()
    private var closed: bool = false
    private var disposed: bool = false

    public static method new(capacity: int): Channel<T> {
        if capacity < 0 {
            throw IllegalArgumentException("Channel capacity cannot be negative")
        }
        var channel = Channel { capacityValue: capacity }
        if channel.lockHandle < 0 {
            throw RuntimeException("could not allocate channel mutex")
        }
        return channel
    }

    public method capacity(): int {
        return capacityValue
    }

    public method length(): int {
        this.lock()
        try {
            var result = buffer.length()
            this.unlock()
            return result
        } catch (error: any) {
            this.unlock()
            throw error
        }
        throw IllegalStateException("Channel.length reached an invalid state")
    }

    public method isEmpty(): bool {
        return this.length() == 0
    }

    public method isClosed(): bool {
        this.lock()
        try {
            var result = closed
            this.unlock()
            return result
        } catch (error: any) {
            this.unlock()
            throw error
        }
        throw IllegalStateException("Channel.isClosed reached an invalid state")
    }

    public method trySend(value: T): ChannelSendStatus {
        this.lock()
        try {
            var result = ChannelSendStatus.Full
            if closed {
                result = ChannelSendStatus.Closed
            } else if capacityValue > 0 && buffer.length() < capacityValue {
                buffer.push(value)
                result = ChannelSendStatus.Sent
            }
            this.unlock()
            return result
        } catch (error: any) {
            this.unlock()
            throw error
        }
        throw IllegalStateException("Channel.trySend reached an invalid state")
    }

    public method tryReceive(): ChannelReceiveStatus<T> {
        this.lock()
        try {
            var result: ChannelReceiveStatus<T> = ChannelReceiveStatus<T>.Empty
            if buffer.isEmpty() {
                if closed {
                    result = ChannelReceiveStatus<T>.Closed
                }
            } else {
                result = ChannelReceiveStatus<T>.Value(buffer.removeAt(0))
            }
            this.unlock()
            return result
        } catch (error: any) {
            this.unlock()
            throw error
        }
        throw IllegalStateException("Channel.tryReceive reached an invalid state")
    }

    // Closing prevents new sends. Buffered values remain available to drain.
    // Returns true only for the call that transitions the channel to closed.
    public method close(): bool {
        this.lock()
        try {
            var changed = closed == false
            closed = true
            this.unlock()
            return changed
        } catch (error: any) {
            this.unlock()
            throw error
        }
        throw IllegalStateException("Channel.close reached an invalid state")
    }

    // Call only after the channel is closed and every user has stopped using
    // it; disposal frees the host mutex owned by this instance.
    public method dispose(): bool {
        if disposed {
            return false
        }
        this.lock()
        try {
            if closed == false || buffer.isEmpty() == false {
                this.unlock()
                return false
            }
            disposed = true
            this.unlock()
            NativeMutex.mutexDestroy(lockHandle)
            return true
        } catch (error: any) {
            this.unlock()
            throw error
        }
        throw IllegalStateException("Channel.dispose reached an invalid state")
    }

    private method lock(): unit {
        if disposed {
            throw IllegalStateException("Channel has been disposed")
        }
        NativeMutex.mutexLock(lockHandle)
    }

    private method unlock(): unit {
        NativeMutex.mutexUnlock(lockHandle)
    }
}

class Channels {
    public static method makeChannel<T>(capacity: int): Channel<T> {
        return Channel<T>.new(capacity)
    }
}
