package builtin.concurrent.async.tasks

// A scope shares one cancellation token across its members and tracks work
// started through spawn. Work executes on the current async runtime thread.
class TaskScope {
    private let token: CancellationToken
    private var activeCount: int = 0
    private var failureCount: int = 0

    public static method new(): TaskScope {
        return TaskScope {
            token: CancellationToken.new(),
            activeCount: 0,
            failureCount: 0
        }
    }

    public method spawn<T>(operation: () -> T): Task<T> {
        if token.isCancelled() {
            return Task<T>.cancelled("task scope was cancelled")
        }
        activeCount += 1
        try {
            token.throwIfCancelled()
            var value = operation()
            activeCount -= 1
            if token.isCancelled() {
                return Task<T>.cancelled(
                    token.cancellationReason().unwrapOr("task scope was cancelled")
                )
            }
            return Task<T>.completed(value)
        } catch (error: any) {
            activeCount -= 1
            if token.isCancelled() {
                return Task<T>.cancelled(
                    token.cancellationReason().unwrapOr("task scope was cancelled")
                )
            }
            failureCount += 1
            return Task<T>.failedWith(error)
        }
        return Task<T>.failed("TaskScope.spawn reached an invalid state")
    }

    public method cancellation(): CancellationToken {
        return token
    }

    public method cancel(): unit {
        token.cancel()
    }

    public method cancelAll(): unit {
        token.cancel()
    }

    public method isCancelled(): bool {
        return token.isCancelled()
    }

    public method hasFailed(): bool {
        return failureCount > 0
    }

    public method failureCount(): int {
        return failureCount
    }

    public method activeTasks(): int {
        return activeCount
    }

    public method isComplete(): bool {
        return activeCount == 0
    }
}
