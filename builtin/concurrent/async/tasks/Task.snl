package builtin.concurrent.async.tasks

import builtin.errors.hierarchy.types

import builtin.core.types.values

enum TaskState {
    Completed,
    Failed,
    Cancelled
}

// Completion value used by Snovalang async functions and task combinators.
// The async/await runtime owns scheduling; this type owns typed completion,
// failure propagation, cancellation state, and value transformations.
struct Task<T> {
    private let state: TaskState
    private let outcome: Result<T, any>

    public static method completed(value: T): Task<T> {
        return Task { state: TaskState.Completed, outcome: Ok(value) }
    }

    public static method completedUnit(): Task<unit> {
        var value: unit = TaskUnit.value()
        return Task { state: TaskState.Completed, outcome: Ok(value) }
    }

    public static method failedUnit(error: string): Task<unit> {
        return Task { state: TaskState.Failed, outcome: Err(error) }
    }

    public static method failedUnitWith<E>(error: E): Task<unit> {
        return Task { state: TaskState.Failed, outcome: Err(error) }
    }

    public static method failed(error: string): Task<T> {
        return Task { state: TaskState.Failed, outcome: Err(error) }
    }

    public static method failedWith<E>(error: E): Task<T> {
        return Task { state: TaskState.Failed, outcome: Err(error) }
    }

    public static method cancelled(reason: string): Task<T> {
        return Task { state: TaskState.Cancelled, outcome: Err(reason) }
    }

    public static method cancelledWith<E>(reason: E): Task<T> {
        return Task { state: TaskState.Cancelled, outcome: Err(reason) }
    }

    public method get(): T {
        if state == TaskState.Cancelled {
            throw RuntimeException(outcome.unwrapErr())
        }
        return outcome.unwrap()
    }

    public method tryGet(): Result<T, any> {
        return outcome
    }

    public method error(): Option<any> {
        if state == TaskState.Completed {
            return None
        }
        return Some(outcome.unwrapErr())
    }

    public method isCompleted(): bool {
        return state == TaskState.Completed
    }

    public method isFailed(): bool {
        return state == TaskState.Failed
    }

    public method isCancelled(): bool {
        return state == TaskState.Cancelled
    }

    public method map<U>(transform: (T) -> U): Task<U> {
        if state == TaskState.Cancelled {
            return Task { state: TaskState.Cancelled, outcome: Err(outcome.unwrapErr()) }
        }
        if state == TaskState.Failed {
            return Task { state: TaskState.Failed, outcome: Err(outcome.unwrapErr()) }
        }
        try {
            return Task { state: TaskState.Completed, outcome: Ok(transform(outcome.unwrap())) }
        } catch (error: any) {
            return Task { state: TaskState.Failed, outcome: Err(error) }
        }
        return Task { state: TaskState.Failed, outcome: Err("Task.map reached an invalid state") }
    }

    public method flatMap<U>(transform: (T) -> Task<U>): Task<U> {
        if state == TaskState.Cancelled {
            return Task { state: TaskState.Cancelled, outcome: Err(outcome.unwrapErr()) }
        }
        if state == TaskState.Failed {
            return Task { state: TaskState.Failed, outcome: Err(outcome.unwrapErr()) }
        }
        try {
            return transform(outcome.unwrap())
        } catch (error: any) {
            return Task { state: TaskState.Failed, outcome: Err(error) }
        }
        return Task { state: TaskState.Failed, outcome: Err("Task.flatMap reached an invalid state") }
    }

    public method recover<E>(recovery: (E) -> T): Task<T> {
        if state == TaskState.Failed {
            try {
                return Task<T>.completed(recovery(outcome.unwrapErr() as E))
            } catch (error: any) {
                return Task { state: TaskState.Failed, outcome: Err(error) }
            }
        }
        return this
    }

    public method recoverCancelled<E>(recovery: (E) -> T): Task<T> {
        if state == TaskState.Cancelled {
            try {
                return Task<T>.completed(recovery(outcome.unwrapErr() as E))
            } catch (error: any) {
                return Task { state: TaskState.Failed, outcome: Err(error) }
            }
        }
        return this
    }
}

class TaskUnit {
    public static method value(): unit {}
}
