package builtin.functional.functional

import builtin.collections.collections
import builtin.types

// Generic, eager functional operations over the builtin Array type.
class Functional {
    public static method map<T, U>(values: Array<T>, transform: (T) -> U): Array<U> {
        var result = Array<U>.new()
        var source = values.copy()
        var i = 0
        while i < source.length() {
            result.push(transform(source.get(i)))
            i += 1
        }
        return result
    }

    public static method filter<T>(values: Array<T>, predicate: (T) -> bool): Array<T> {
        var result = Array<T>.new()
        var source = values.copy()
        var i = 0
        while i < source.length() {
            var value = source.get(i)
            if predicate(value) {
                result.push(value)
            }
            i += 1
        }
        return result
    }

    public static method flatMap<T, U>(
        values: Array<T>, transform: (T) -> Array<U>
    ): Array<U> {
        var result = Array<U>.new()
        var source = values.copy()
        var i = 0
        while i < source.length() {
            var mapped = transform(source.get(i))
            var j = 0
            while j < mapped.length() {
                result.push(mapped.get(j))
                j += 1
            }
            i += 1
        }
        return result
    }

    public static method fold<T, A>(
        values: Array<T>, initial: A, combine: (A, T) -> A
    ): A {
        var accumulator = initial
        var source = values.copy()
        var i = 0
        while i < source.length() {
            accumulator = combine(accumulator, source.get(i))
            i += 1
        }
        return accumulator
    }

    public static method forEach<T>(values: Array<T>, action: (T) -> unit): unit {
        var source = values.copy()
        var i = 0
        while i < source.length() {
            action(source.get(i))
            i += 1
        }
    }

    public static method any<T>(values: Array<T>, predicate: (T) -> bool): bool {
        var source = values.copy()
        var i = 0
        while i < source.length() {
            if predicate(source.get(i)) {
                return true
            }
            i += 1
        }
        return false
    }

    public static method all<T>(values: Array<T>, predicate: (T) -> bool): bool {
        var source = values.copy()
        var i = 0
        while i < source.length() {
            if predicate(source.get(i)) == false {
                return false
            }
            i += 1
        }
        return true
    }

    public static method find<T>(values: Array<T>, predicate: (T) -> bool): Option<T> {
        var source = values.copy()
        var i = 0
        while i < source.length() {
            var value = source.get(i)
            if predicate(value) {
                return Some(value)
            }
            i += 1
        }
        return None
    }

    public static method findIndex<T>(values: Array<T>, predicate: (T) -> bool): int {
        var source = values.copy()
        var i = 0
        while i < source.length() {
            if predicate(source.get(i)) {
                return i
            }
            i += 1
        }
        return -1
    }

    public static method countWhere<T>(values: Array<T>, predicate: (T) -> bool): int {
        var source = values.copy()
        var count = 0
        var i = 0
        while i < source.length() {
            if predicate(source.get(i)) {
                count += 1
            }
            i += 1
        }
        return count
    }
}
