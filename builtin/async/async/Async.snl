package builtin.async.async

import builtin.errors.errors

import builtin.time.time

class Async {
    public static method isCancelled(token: CancellationToken): bool {
        return token.isCancelled()
    }

    public static method isScopeCancelled(scope: TaskScope): bool {
        return scope.isCancelled()
    }

    public static method spawn<T>(operation: () -> T): Task<T> {
        return TaskScope.new().spawn(operation)
    }

    public static method scope(action: (TaskScope) -> unit): Task<unit> {
        var scope = TaskScope.new()
        try {
            action(scope)
            if scope.hasFailed() {
                scope.cancelAll()
                return Task.failedUnit("one or more scoped tasks failed")
            }
            return Task<unit>.completedUnit()
        } catch (error: any) {
            scope.cancelAll()
            return Task.failedUnitWith(error)
        }
        return Task.failedUnit("Async.scope reached an invalid state")
    }

    public static method sleep(milliseconds: int): Task<unit> {
        if milliseconds < 0 {
            throw IllegalArgumentException("Async.sleep duration cannot be negative")
        }
        Time.sleep(Duration.milliseconds(milliseconds as long))
        return Task<unit>.completedUnit()
    }

    public static method sleep(duration: Duration): Task<unit> {
        if duration.isNegative() {
            throw IllegalArgumentException("Async.sleep duration cannot be negative")
        }
        Time.sleep(duration)
        return Task<unit>.completedUnit()
    }
}
