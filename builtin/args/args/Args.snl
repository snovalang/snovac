package builtin.args.args

import builtin.errors.errors

import builtin.runtime.runtime
import builtin.collections.collections
import builtin.types

class Args {
    public static method count(): int {
        return Runtime.argumentCount()
    }

    public static method get(index: int): string {
        if index < 0 || index >= Runtime.argumentCount() {
            throw IndexOutOfBoundsException("argument index out of bounds")
        }
        return Runtime.argument(index)
    }

    public static method tryGet(index: int): Option<string> {
        if index < 0 || index >= Runtime.argumentCount() {
            return None
        }
        return Some(Runtime.argument(index))
    }

    public static method all(): Array<string> {
        var result = Array<string>.new()
        var i = 0
        while i < Runtime.argumentCount() {
            result.push(Runtime.argument(i))
            i += 1
        }
        return result
    }
}
