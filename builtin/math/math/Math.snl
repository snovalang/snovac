package builtin.math.math

import builtin.errors.errors

import builtin.types

class Math {
    public static method abs(value: int): int {
        match Math.checkedAbs(value) {
            Ok(magnitude) -> return magnitude
            Err(error) -> throw RuntimeException(error)
        }
    }

    public static method checkedAbs(value: int): Result<int, string> {
        if value == -9223372036854775807 - 1 {
            return Err("absolute value overflows for the minimum integer")
        }
        if value < 0 {
            return Ok(-value)
        }
        return Ok(value)
    }

    public static method absLong(value: long): long {
        match Math.checkedAbsLong(value) {
            Ok(magnitude) -> return magnitude
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.absLong reached an invalid state")
    }

    public static method checkedAbsLong(value: long): Result<long, string> {
        if value == -9223372036854775807L - 1L {
            return Err("absolute value overflows for the minimum long")
        }
        if value < 0L {
            return Ok(-value)
        }
        return Ok(value)
    }

    public static method checkedAddLong(left: long, right: long): Result<long, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if right > 0L && left > maximum - right {
            return Err("long addition overflow")
        }
        if right < 0L && left < minimum - right {
            return Err("long addition overflow")
        }
        return Ok(left + right)
    }

    public static method addLong(left: long, right: long): long {
        match Math.checkedAddLong(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.addLong reached an invalid state")
    }

    public static method checkedSubtractLong(left: long, right: long): Result<long, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if right < 0L && left > maximum + right {
            return Err("long subtraction overflow")
        }
        if right > 0L && left < minimum + right {
            return Err("long subtraction overflow")
        }
        return Ok(left - right)
    }

    public static method subtractLong(left: long, right: long): long {
        match Math.checkedSubtractLong(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.subtractLong reached an invalid state")
    }

    public static method checkedMultiplyLong(left: long, right: long): Result<long, string> {
        var maximum: long = 9223372036854775807L
        var minimum: long = -9223372036854775807L - 1L
        if left == 0L || right == 0L {
            return Ok(0L)
        }
        if (left == minimum && right == -1L) || (right == minimum && left == -1L) {
            return Err("long multiplication overflow")
        }
        if left > 0L {
            if right > 0L && left > maximum / right { return Err("long multiplication overflow") }
            if right < 0L && right < minimum / left { return Err("long multiplication overflow") }
        } else {
            if right > 0L && left < minimum / right { return Err("long multiplication overflow") }
            if right < 0L && left < maximum / right { return Err("long multiplication overflow") }
        }
        return Ok(left * right)
    }

    public static method multiplyLong(left: long, right: long): long {
        match Math.checkedMultiplyLong(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.multiplyLong reached an invalid state")
    }

    public static method checkedDivideLong(left: long, right: long): Result<long, string> {
        if right == 0L {
            return Err("long division by zero")
        }
        if left == -9223372036854775807L - 1L && right == -1L {
            return Err("long division overflow")
        }
        return Ok(left / right)
    }

    public static method divideLong(left: long, right: long): long {
        match Math.checkedDivideLong(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.divideLong reached an invalid state")
    }

    public static method checkedPowLong(base: long, exponent: int): Result<long, string> {
        if exponent < 0 {
            return Err("integer exponent cannot be negative")
        }
        var result: long = 1L
        var i = 0
        while i < exponent {
            match Math.checkedMultiplyLong(result, base) {
                Ok(next) -> result = next
                Err(error) -> return Err(error)
            }
            i += 1
        }
        return Ok(result)
    }

    public static method checkedGcdLong(left: long, right: long): Result<long, string> {
        var a = left
        var b = right
        if a > 0L { a = -a }
        if b > 0L { b = -b }
        while b != 0L {
            var remainder = a % b
            a = b
            b = remainder
        }
        if a == -9223372036854775807L - 1L {
            return Err("greatest common divisor does not fit in positive long")
        }
        return Ok(-a)
    }

    public static method gcdLong(left: long, right: long): long {
        match Math.checkedGcdLong(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.gcdLong reached an invalid state")
    }

    public static method checkedLcmLong(left: long, right: long): Result<long, string> {
        if left == 0L || right == 0L {
            return Ok(0L)
        }
        var gcdResult = Math.checkedGcdLong(left, right)
        if gcdResult.isErr() {
            return Err(gcdResult.unwrapErr())
        }
        match Math.checkedMultiplyLong(left / gcdResult.unwrap(), right) {
            Err(error) -> return Err(error)
            Ok(product) -> {
                if product == -9223372036854775807L - 1L {
                    return Err("least common multiple absolute value overflow")
                }
                if product < 0L {
                    return Ok(-product)
                }
                return Ok(product)
            }
        }
        return Err("Math.checkedLcmLong reached an invalid state")
    }

    public static method lcmLong(left: long, right: long): long {
        match Math.checkedLcmLong(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.lcmLong reached an invalid state")
    }

    public static method minLong(left: long, right: long): long {
        if left < right { return left }
        return right
    }

    public static method maxLong(left: long, right: long): long {
        if left > right { return left }
        return right
    }

    public static method clampLong(value: long, lower: long, upper: long): long {
        if lower > upper {
            throw RuntimeException("Math.clampLong lower bound must not exceed upper bound")
        }
        if value < lower { return lower }
        if value > upper { return upper }
        return value
    }

    public static method signLong(value: long): int {
        if value < 0L { return -1 }
        if value > 0L { return 1 }
        return 0
    }

    public static method isEvenLong(value: long): bool {
        return value % 2L == 0L
    }

    public static method isOddLong(value: long): bool {
        return value % 2L != 0L
    }

    public static method powLong(base: long, exponent: int): long {
        match Math.checkedPowLong(base, exponent) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.powLong reached an invalid state")
    }

    public static method sqrt(value: double): double {
        match Math.checkedSqrt(value) {
            Ok(root) -> return root
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.sqrt reached an invalid state")
    }

    public static method checkedSqrt(value: double): Result<double, string> {
        if value < 0.0 as double {
            return Err("square root requires a non-negative value")
        }
        if value == 0.0 as double {
            return Ok(0.0 as double)
        }

        var estimate = value
        if estimate < 1.0 as double {
            estimate = 1.0 as double
        }
        var iteration = 0
        while iteration < 2048 {
            var next = (estimate + value / estimate) / (2.0 as double)
            if next == estimate {
                return Ok(next)
            }
            estimate = next
            iteration += 1
        }
        return Ok(estimate)
    }

    public static method sqrtFloat(value: float): Result<float, string> {
        match Math.checkedSqrt(value as double) {
            Ok(root) -> return Ok(root as float)
            Err(error) -> return Err(error)
        }
        return Err("Math.sqrtFloat reached an invalid state")
    }

    public static method absDouble(value: double): double {
        if value < 0.0 as double {
            return -value
        }
        return value
    }

    public static method minDouble(left: double, right: double): double {
        if left < right { return left }
        return right
    }

    public static method maxDouble(left: double, right: double): double {
        if left > right { return left }
        return right
    }

    public static method clampDouble(value: double, lower: double, upper: double): double {
        if lower > upper {
            throw RuntimeException("Math.clampDouble lower bound must not exceed upper bound")
        }
        if value < lower { return lower }
        if value > upper { return upper }
        return value
    }

    public static method checkedPowDouble(base: double, exponent: int): Result<double, string> {
        if base == 0.0 as double && exponent < 0 {
            return Err("zero cannot be raised to a negative exponent")
        }
        var remaining = exponent
        var result: double = 1.0 as double
        var factor = base
        var maximum: double = 1.7976931348623157e308
        if exponent < 0 {
            factor = (1.0 as double) / base
            if factor == 0.0 as double {
                return Ok(0.0 as double)
            }
            if factor > maximum || factor < -maximum {
                return Err("floating-point exponentiation overflow")
            }
        }
        while remaining != 0 {
            if remaining % 2 != 0 {
                result = result * factor
                if result > maximum || result < -maximum {
                    return Err("floating-point exponentiation overflow")
                }
            }
            remaining = remaining / 2
            if remaining != 0 {
                factor = factor * factor
                if factor > maximum || factor < -maximum {
                    return Err("floating-point exponentiation overflow")
                }
            }
        }
        return Ok(result)
    }

    public static method powDouble(base: double, exponent: int): double {
        match Math.checkedPowDouble(base, exponent) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
        throw IllegalStateException("Math.powDouble reached an invalid state")
    }

    public static method min(left: int, right: int): int {
        if left < right {
            return left
        }
        return right
    }

    public static method max(left: int, right: int): int {
        if left > right {
            return left
        }
        return right
    }

    public static method clamp(value: int, lower: int, upper: int): int {
        if lower > upper {
            throw RuntimeException("Math.clamp lower bound must not exceed upper bound")
        }
        if value < lower {
            return lower
        }
        if value > upper {
            return upper
        }
        return value
    }

    public static method isEven(value: int): bool {
        return value % 2 == 0
    }

    public static method isOdd(value: int): bool {
        return value % 2 != 0
    }

    public static method sign(value: int): int {
        if value < 0 { return -1 }
        if value > 0 { return 1 }
        return 0
    }

    public static method gcd(left: int, right: int): int {
        match Math.checkedGcd(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
    }

    public static method checkedGcd(left: int, right: int): Result<int, string> {
        var a = left
        var b = right
        if a > 0 { a = -a }
        if b > 0 { b = -b }
        while b != 0 {
            var remainder = a % b
            a = b
            b = remainder
        }
        if a == -9223372036854775807 - 1 {
            return Err("greatest common divisor does not fit in positive int")
        }
        return Ok(-a)
    }

    public static method lcm(left: int, right: int): int {
        match Math.checkedLcm(left, right) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
    }

    public static method checkedLcm(left: int, right: int): Result<int, string> {
        if left == 0 || right == 0 {
            return Ok(0)
        }
        var gcdResult = Math.checkedGcd(left, right)
        if gcdResult.isErr() {
            return Err(gcdResult.unwrapErr())
        }
        var productResult = Math.checkedMultiply(left / gcdResult.unwrap(), right)
        match productResult {
            Err(error) -> return Err(error)
            Ok(product) -> {
                if product == -9223372036854775807 - 1 {
                    return Err("least common multiple absolute value overflow")
                }
                if product < 0 {
                    return Ok(-product)
                }
                return Ok(product)
            }
        }
    }

    public static method checkedMultiply(left: int, right: int): Result<int, string> {
        var maximum: int = 9223372036854775807
        var minimum: int = -9223372036854775807 - 1
        if left == 0 || right == 0 {
            return Ok(0)
        }
        if (left == minimum && right == -1) || (right == minimum && left == -1) {
            return Err("integer multiplication overflow")
        }
        if left > 0 {
            if right > 0 && left > maximum / right { return Err("integer multiplication overflow") }
            if right < 0 && right < minimum / left { return Err("integer multiplication overflow") }
        } else {
            if right > 0 && left < minimum / right { return Err("integer multiplication overflow") }
            if right < 0 && left < maximum / right { return Err("integer multiplication overflow") }
        }
        return Ok(left * right)
    }

    public static method pow(base: int, exponent: int): int {
        match Math.checkedPow(base, exponent) {
            Ok(value) -> return value
            Err(error) -> throw RuntimeException(error)
        }
    }

    public static method checkedPow(base: int, exponent: int): Result<int, string> {
        if exponent < 0 {
            return Err("integer exponent cannot be negative")
        }
        var result = 1
        var i = 0
        while i < exponent {
            match Math.checkedMultiply(result, base) {
                Err(error) -> return Err(error)
                Ok(next) -> result = next
            }
            i += 1
        }
        return Ok(result)
    }
}
