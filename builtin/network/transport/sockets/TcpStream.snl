package builtin.network.transport.sockets

import builtin.errors.hierarchy.types

import builtin.core.types.values

class TcpStream {
    private let handle: int
    private var closed: bool = false

    public method isClosed(): bool {
        return closed
    }

    public method read(maxLength: int): string {
        if closed {
            throw IllegalStateException("TcpStream is closed")
        }
        if maxLength <= 0 {
            throw IllegalArgumentException("TcpStream.read length must be positive")
        }
        return Socket.receive(handle, maxLength)
    }

    public method writeAll(data: string): unit {
        if closed { throw IllegalStateException("TcpStream is closed") }
        var offset = 0
        while offset < data.length() {
            var sent = Socket.send(handle, data.substring(offset, data.length()))
            if sent <= 0 || sent > data.length() - offset {
                throw RuntimeException("TcpStream.writeAll failed")
            }
            offset += sent
        }
    }

    public method tryWrite(data: string): Result<int, string> {
        if closed {
            return Err("TcpStream is closed")
        }
        var written = Socket.send(handle, data)
        if written < 0 {
            return Err("TcpStream.write failed")
        }
        return Ok(written)
    }

    public method write(data: string): int {
        match this.tryWrite(data) {
            Ok(written) -> return written
            Err(error) -> throw RuntimeException(error)
        }
    }

    public method close(): unit {
        if closed == false {
            Socket.close(handle)
            closed = true
        }
    }
}
