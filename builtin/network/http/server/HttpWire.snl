package builtin.network.http.server

import builtin.collections.collections.types
import builtin.network.http.data.types
import builtin.network.transport.sockets
import builtin.text.parsing.results
import builtin.errors.hierarchy.types

// Bounded HTTP/1.1 text framing. One request is served per connection.
class HttpWire {
    private static method split(text: string, delimiter: string): Array<string> {
        var parts = Array<string>.new()
        var rest = text
        var position = rest.indexOf(delimiter)
        while position >= 0 {
            parts.push(rest.substring(0, position))
            rest = rest.substring(position + delimiter.length(), rest.length())
            position = rest.indexOf(delimiter)
        }
        parts.push(rest)
        return parts
    }

    private static method contentLength(headers: Array<Header>): int {
        var length = 0
        var seen = false
        var i = 0
        while i < headers.length() {
            var header = headers.get(i)
            var name = header.name.toLower()
            if name == "transfer-encoding" {
                throw IllegalArgumentException("chunked request bodies are not supported")
            }
            if name == "content-length" {
                if seen { throw IllegalArgumentException("duplicate Content-Length") }
                seen = true
                if header.value.isEmpty() {
                    throw IllegalArgumentException("invalid Content-Length")
                }
                var digit = 0
                while digit < header.value.length() {
                    var character = header.value.substring(digit, digit + 1)
                    if "0123456789".contains(character) == false {
                        throw IllegalArgumentException("invalid Content-Length")
                    }
                    digit += 1
                }
                match parseInt(header.value) {
                    Ok(parsed) -> {
                        if parsed < 0 || parsed > 1048576 {
                            throw IllegalArgumentException("request body exceeds limit")
                        }
                        length = parsed
                    }
                    Err(_) -> throw IllegalArgumentException("invalid Content-Length")
                }
            }
            i += 1
        }
        return length
    }

    private static method parseHead(head: string, body: string): HttpRequest {
        var lines = HttpWire.split(head, "\r\n")
        if lines.isEmpty() { throw IllegalArgumentException("empty HTTP request") }
        var first = HttpWire.split(lines.get(0), " ")
        if first.length() != 3 || first.get(2) != "HTTP/1.1" ||
            first.get(0).isEmpty() || first.get(1).startsWith("/") == false {
            throw IllegalArgumentException("invalid HTTP/1.1 request line")
        }
        var headers = Array<Header>.new()
        var i = 1
        while i < lines.length() {
            var line = lines.get(i)
            var colon = line.indexOf(":")
            if colon <= 0 || line.startsWith(" ") || line.startsWith("\t") {
                throw IllegalArgumentException("invalid HTTP header line")
            }
            var header = Header {
                name: line.substring(0, colon),
                value: line.substring(colon + 1, line.length()).trim()
            }
            if header.isValid() == false {
                throw IllegalArgumentException("invalid HTTP header")
            }
            headers.push(header)
            i += 1
        }
        var host = false
        i = 0
        while i < headers.length() {
            if headers.get(i).isNamed("Host") { host = true }
            i += 1
        }
        if host == false { throw IllegalArgumentException("Host header is required") }
        return HttpRequest {
            method: first.get(0), target: first.get(1), headers: headers, body: body
        }
    }

    public static method readRequest(stream: TcpStream): HttpRequest {
        var raw = ""
        var marker = -1
        while marker < 0 {
            if raw.length() > 16384 {
                throw IllegalArgumentException("HTTP headers exceed 16 KiB")
            }
            var chunk = stream.read(4096)
            if chunk.isEmpty() { throw IllegalArgumentException("incomplete HTTP headers") }
            raw = raw + chunk
            marker = raw.indexOf("\r\n\r\n")
        }
        if marker > 16384 { throw IllegalArgumentException("HTTP headers exceed 16 KiB") }
        var head = raw.substring(0, marker)
        var initialBody = raw.substring(marker + 4, raw.length())
        var request = HttpWire.parseHead(head, "")
        var length = HttpWire.contentLength(request.headers)
        var body = initialBody
        while body.length() < length {
            var count = length - body.length()
            if count > 4096 { count = 4096 }
            var chunk = stream.read(count)
            if chunk.isEmpty() { throw IllegalArgumentException("incomplete HTTP body") }
            body = body + chunk
        }
        return HttpRequest {
            method: request.method,
            target: request.target,
            headers: request.headers,
            body: body.substring(0, length)
        }
    }

    private static method reason(status: int): string {
        if status == 200 { return "OK" }
        if status == 201 { return "Created" }
        if status == 202 { return "Accepted" }
        if status == 204 { return "No Content" }
        if status == 301 { return "Moved Permanently" }
        if status == 302 { return "Found" }
        if status == 304 { return "Not Modified" }
        if status == 400 { return "Bad Request" }
        if status == 401 { return "Unauthorized" }
        if status == 403 { return "Forbidden" }
        if status == 404 { return "Not Found" }
        if status == 405 { return "Method Not Allowed" }
        if status == 413 { return "Content Too Large" }
        if status == 431 { return "Request Header Fields Too Large" }
        if status == 500 { return "Internal Server Error" }
        if status == 503 { return "Service Unavailable" }
        return "Status"
    }

    public static method writeResponse(stream: TcpStream, response: HttpResponse,
                                       includeBody: bool): unit {
        if response.status < 100 || response.status > 599 {
            throw IllegalArgumentException("invalid HTTP response status")
        }
        var body = response.body
        if response.status < 200 || response.status == 204 || response.status == 304 {
            body = ""
        }
        var wire = "HTTP/1.1 " + response.status.toString() + " " +
            HttpWire.reason(response.status) + "\r\n"
        var i = 0
        while i < response.headers.length() {
            var header = response.headers.get(i)
            var name = header.name.toLower()
            if header.isValid() == false || name == "content-length" ||
                name == "transfer-encoding" || name == "connection" {
                throw IllegalArgumentException("invalid or reserved HTTP response header")
            }
            wire = wire + header.name + ": " + header.value + "\r\n"
            i += 1
        }
        wire = wire + "Content-Length: " + body.length().toString() +
            "\r\nConnection: close\r\n\r\n"
        stream.writeAll(wire)
        if includeBody { stream.writeAll(body) }
    }
}
