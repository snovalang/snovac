package builtin.runtime.host.api

// Paths are resolved from the process working directory at runtime.
class Runtime {
    @Native
    public static method readLine(): string

    @Native
    public static method fileExists(path: string): bool

    @Native
    public static method readText(path: string): string

    @Native
    public static method writeText(path: string, text: string): bool

    @Native
    public static method environment(name: string): string

    @Native
    public static method argumentCount(): int

    @Native
    public static method argument(index: int): string
}
