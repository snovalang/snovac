package builtin.net.http.types

struct Header {
    name: string
    value: string

    public method isValid(): bool {
        if name.isEmpty() || name != name.trim() {
            return false
        }
        if value.contains("\r") || value.contains("\n") || value.contains("\0") {
            return false
        }
        var letters = "abcdefghijklmnopqrstuvwxyz"
        var digits = "0123456789"
        var punctuation = "!#$%&'*+-.^_`|~"
        var i = 0
        while i < name.length() {
            var character = name[i].toString()
            if letters.contains(character.toLower()) == false &&
                digits.contains(character) == false &&
                punctuation.contains(character) == false {
                return false
            }
            i += 1
        }
        return true
    }

    public method isNamed(candidate: string): bool {
        return name.toLower() == candidate.toLower()
    }

    public method normalizedName(): string {
        return name.toLower()
    }
}
