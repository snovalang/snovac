package builtin.core.types.values

import builtin.errors.hierarchy.types

enum Option<T> {
    Some(value: T),
    None,

    public method isSome(): bool {
        return match this {
            Some(_) -> true
            None -> false
        }
    }

    public method isNone(): bool {
        return match this {
            Some(_) -> false
            None -> true
        }
    }

    public method contains(value: T): bool {
        return match this {
            Some(found) -> found == value
            None -> false
        }
    }

    public method unwrap(): T {
        match this {
            Some(value) -> return value
            None -> throw IllegalStateException("Option.unwrap called on None")
        }
    }

    public method expect(message: string): T {
        match this {
            Some(value) -> return value
            None -> throw IllegalStateException(message)
        }
    }

    public method unwrapOr(fallback: T): T {
        return match this {
            Some(value) -> value
            None -> fallback
        }
    }

    public method unwrapOrElse(fallback: () -> T): T {
        return match this {
            Some(value) -> value
            None -> fallback()
        }
    }

    public method orElse(fallback: () -> Option<T>): Option<T> {
        return match this {
            Some(_) -> this
            None -> fallback()
        }
    }

    public method map<U>(transform: (T) -> U): Option<U> {
        return match this {
            Some(value) -> Some(transform(value))
            None -> None
        }
    }

    public method flatMap<U>(transform: (T) -> Option<U>): Option<U> {
        return match this {
            Some(value) -> transform(value)
            None -> None
        }
    }

    public method and<U>(next: Option<U>): Option<U> {
        return match this {
            Some(_) -> next
            None -> None
        }
    }

    public method xor(other: Option<T>): Option<T> {
        return match this {
            Some(value) -> match other {
                Some(_) -> None
                None -> Some(value)
            }
            None -> other
        }
    }

    public method filter(predicate: (T) -> bool): Option<T> {
        match this {
            Some(value) -> {
                if predicate(value) { return Some(value) }
            }
            None -> {}
        }
        return None
    }

    public method okOr<E>(error: E): Result<T, E> {
        return match this {
            Some(value) -> Result<T, E>.Ok(value)
            None -> Result<T, E>.Err(error)
        }
    }
}
