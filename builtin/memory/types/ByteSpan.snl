package builtin.memory.types

import builtin.errors.errors

import builtin.collections.collections
import builtin.types

// A checked view into an Snovalang byte array. The view shares its backing
// array but exposes no pointer arithmetic or host layout assumptions.
struct ByteSpan {
    private let storage: Array<byte>
    private let offset: int
    public let length: int64

    public static method empty(): ByteSpan {
        return ByteSpan { storage: Array<byte>.new(), offset: 0, length: 0L as int64 }
    }

    public static method fromArray(bytes: Array<byte>): ByteSpan {
        return ByteSpan { storage: bytes, offset: 0, length: bytes.length() as int64 }
    }

    public static method view(bytes: Array<byte>, start: int, count: int): ByteSpan {
        if start < 0 || count < 0 || start > bytes.length() || count > bytes.length() - start {
            throw IndexOutOfBoundsException("ByteSpan.view range is out of bounds")
        }
        return ByteSpan { storage: bytes, offset: start, length: count as int64 }
    }

    public method isEmpty(): bool {
        var zero: int64 = 0L as int64
        return length == zero
    }

    public method len(): int {
        return length as int
    }

    public method get(index: int): byte {
        if index < 0 || (index as int64) >= length {
            throw IndexOutOfBoundsException("ByteSpan index out of bounds")
        }
        return storage.get(offset + index)
    }

    public method tryGet(index: int): Option<byte> {
        if index < 0 || (index as int64) >= length {
            return None
        }
        return Some(storage.get(offset + index))
    }

    public method set(index: int, value: byte): unit {
        if index < 0 || (index as int64) >= length {
            throw IndexOutOfBoundsException("ByteSpan index out of bounds")
        }
        storage.set(offset + index, value)
    }

    public method trySet(index: int, value: byte): bool {
        if index < 0 || (index as int64) >= length {
            return false
        }
        storage.set(offset + index, value)
        return true
    }

    public method slice(start: int, count: int): ByteSpan {
        if start < 0 || count < 0 || (start as int64) > length ||
            (count as int64) > length - (start as int64) {
            throw IndexOutOfBoundsException("ByteSpan.slice range is out of bounds")
        }
        return ByteSpan {
            storage: storage,
            offset: offset + start,
            length: count as int64
        }
    }

    public method toArray(): Array<byte> {
        var result = Array<byte>.new()
        var i = 0
        while (i as int64) < length {
            result.push(storage.get(offset + i))
            i += 1
        }
        return result
    }

    public method copyTo(target: ByteSpan, targetOffset: int): unit {
        this.copyRangeTo(target, 0, targetOffset, this.len())
    }

    public method copyRangeTo(target: ByteSpan, sourceOffset: int,
                              targetOffset: int, count: int): unit {
        if sourceOffset < 0 || count < 0 || sourceOffset > this.len() ||
            count > this.len() - sourceOffset {
            throw IndexOutOfBoundsException("ByteSpan.copyRangeTo source range is out of bounds")
        }
        if targetOffset < 0 || targetOffset > target.len() ||
            count > target.len() - targetOffset {
            throw IndexOutOfBoundsException("ByteSpan.copyTo range is out of bounds")
        }
        var sourceStart = offset + sourceOffset
        var targetStart = target.offset + targetOffset
        if storage == target.storage && targetStart > sourceStart &&
            targetStart < sourceStart + count {
            var i = count - 1
            while i >= 0 {
                target.set(targetOffset + i, storage.get(sourceStart + i))
                i -= 1
            }
        } else {
            var i = 0
            while i < count {
                target.set(targetOffset + i, storage.get(sourceStart + i))
                i += 1
            }
        }
    }

    public method contentEquals(other: ByteSpan): bool {
        if length != other.length {
            return false
        }
        var i = 0
        while (i as int64) < length {
            if this.get(i) != other.get(i) {
                return false
            }
            i += 1
        }
        return true
    }

    public method indexOf(value: byte): int {
        var i = 0
        while (i as int64) < length {
            if this.get(i) == value {
                return i
            }
            i += 1
        }
        return -1
    }

    public method fill(value: byte): unit {
        var i = 0
        while (i as int64) < length {
            this.set(i, value)
            i += 1
        }
    }
}
