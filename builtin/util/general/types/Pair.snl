package builtin.util.general.types

struct Pair<A, B> {
    first: A
    second: B

    public method swap(): Pair<B, A> {
        return Pair { first: second, second: first }
    }

    public method mapFirst<C>(transform: (A) -> C): Pair<C, B> {
        return Pair { first: transform(first), second: second }
    }

    public method mapSecond<C>(transform: (B) -> C): Pair<A, C> {
        return Pair { first: first, second: transform(second) }
    }

    public method map<C, D>(mapFirst: (A) -> C, mapSecond: (B) -> D): Pair<C, D> {
        return Pair {
            first: mapFirst(first),
            second: mapSecond(second)
        }
    }
}
